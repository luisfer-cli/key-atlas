    static t(key) {
        if (this.Strings.Has(this.Lang) && this.Strings[this.Lang].Has(key))
            return this.Strings[this.Lang][key]
        ; fallback to English
        if (this.Strings.Has("en") && this.Strings["en"].Has(key))
            return this.Strings["en"][key]
        return key
    }
